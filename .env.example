# Quality One Care HR Portal — environment variables
#
# When deploying to Railway, these values go in:
#   Railway dashboard → your service → Variables tab
#
# DO NOT commit .env to git. Only .env.example (with no real secrets).

# ─── REQUIRED ────────────────────────────────────────────────────
# Provided automatically by Railway when you add a Postgres service to your project.
# Railway sets the DATABASE_URL variable; just reference it.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Long random string (32+ chars). Generate one fresh per environment:
#   openssl rand -base64 32
# Or use a password manager / random generator.
AUTH_SECRET=replace-with-a-long-random-secret-32-characters-or-more

# Public URL of the deployed app (no trailing slash).
# Railway gives you a *.up.railway.app URL automatically when you deploy;
# put that here, then update later when you attach a custom domain.
NEXT_PUBLIC_APP_URL=https://your-app.up.railway.app

# ─── PRODUCTION (recommended) ────────────────────────────────────
NODE_ENV=production
JOB_RUNNER_ENABLED=true
JOB_RUNNER_POLL_SECONDS=60

# ─── OPTIONAL — ENABLE WHEN YOU HAVE THESE ACCOUNTS ──────────────
# OCR (local fallback works without a paid provider)
OCR_PROVIDER=local
OCR_API_KEY=

# AI (rule-based fallback works without a paid provider)
AI_PROVIDER=
AI_API_KEY=

# Email (queue fallback works without a paid provider)
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=noreply@qualityonecare.local

# Storage (local fallback works for low volume; switch to S3/R2 for scale)
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=

# Document analysis tuning (defaults work)
DOCUMENT_ANALYSIS_PROVIDER=none
DOCUMENT_ANALYSIS_CONFIDENCE_THRESHOLD=0.90

# Local LLM endpoints (only set if you run Ollama or LM Studio nearby)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Cloud LLM (optional, only if you sign up)
GROQ_API_KEY=
GROQ_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
LOCAL_DOCUMENT_ANALYZER_URL=http://localhost:8000/analyze

# External verification providers (paid — only set when you sign up)
NURSYS_API_KEY=
CHECKR_API_KEY=
MD_COURT_RECORDS_API_KEY=
